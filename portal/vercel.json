{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/n8n-webhook",
      "destination": "https://mustrain.app.n8n.cloud/webhook/support-intake-v2"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
