{
  "name": "Error handler: DLQ + Slack alert",
  "nodes": [
    {
      "parameters": {},
      "id": "823bbbbe-124b-519b-9cad-e69b97eb106c",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
