        0,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst ex = e.execution || {};\nconst wf = e.workflow || {};\nconst errorObj = ex.error || {};\nconst message = errorObj.message || errorObj.description || 'Erreur non spécifiée';\nconst failedNode = ex.lastNodeExecuted || 'Nœud non identifié';\nconst workflowName = wf.name || 'Workshop - Traitement des demandes clients';\nconst executionId = ex.id || 'N/A';\nconst executionUrl = ex.url || ('https://mustrain.app.n8n.cloud/execution/' + executionId);\nconst now = new Date().toISOString();\n\nconst slackText = [\n  '🚨 *ALERTE PANNE WORKFLOW (DLQ)*',\n  '• *Workflow :* `' + workflowName + '`',\n  '• *Nœud en panne :* `' + failedNode + '`',\n  '• *Erreur :* _' + message + '_',\n  '• *ID Exécution :* `' + executionId + '`',\n  '• *Lien direct :* ' + executionUrl,\n  '• *Action :* Corrigez le problème puis cliquez sur *Retry execution* dans n8n.'\n].join('\\n');\n\nreturn [{\n  json: {\n    row: {\n      timestamp: now,\n      logged_at: now,\n      workflow: workflowName,\n      executionId: executionId,\n      execution_id: executionId,\n      ticket_id: 'ERR-' + executionId,\n      failedNode: failedNode,\n      error: message,\n      executionUrl: executionUrl,\n      status: 'ERROR',\n      priority: 'CRITICAL',\n      event: 'ERROR: ' + failedNode,\n      intent: message\n    },\n    slackText\n  }\n}];"
      },
      "id": "5ebc16e1-2d5d-5515-a6a2-cf0fc7756c49",
      "name": "Format error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
